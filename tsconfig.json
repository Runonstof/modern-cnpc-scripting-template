{
    "compilerOptions": {
      "target": "es5",
      "module": "esnext",
      "moduleResolution": "node",
      "strict": true,
      "esModuleInterop": true,
      "outDir": "ecmascript",
      "baseUrl": "src",
      "paths": {
        "~/*": ["*"]
      },
      "typeRoots": ["src/types", "node_modules/@types"]
    },
    "include": ["src/**/*"]
  }
